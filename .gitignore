# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Environment
.env
.env.local

# Build artifacts — the database is regenerated from schema/*.sql by
# schema/build.sh and is never source. Delete it freely.
*.db
*.sqlite
*.sqlite3

# Swift Package Manager output
.build/
.swiftpm/
Package.resolved

# Xcode per-user state: window positions, which files were open, scroll
# offsets, breakpoints. Changes on every click and belongs to one person, so
# committing it means permanent diff noise and guaranteed conflicts.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Xcode build output — regenerated, and large.
DerivedData/
build/

# Spreadsheet lock files
~$*.xlsx
.~lock.*#

# Dependencies (uncomment once the backend exists)
# /node_modules
# /vendor/bundle
# /.bundle

# Xcode workspace settings — an empty plist Xcode regenerates
*.xcsettings
